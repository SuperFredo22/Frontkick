---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');

// ── Tri robuste par date décroissante ──────────────────────────────────────
function parseDate(s: string): number {
  if (!s) return 0;
  const d = new Date(s);
  if (!isNaN(d.getTime())) return d.getTime();
  const y = s.match(/\d{4}/);
  return y ? parseInt(y[0]) * 1_000_000 : 0;
}

const sorted = [...allArticles].sort((a, b) =>
  parseDate(b.data.date) - parseDate(a.data.date)
);

// ── À la une : article featured, sinon dernière actu, sinon plus récent ────
const featuredArticle =
  sorted.find(a => a.data.featured) ??
  sorted.find(a => a.data.category === 'actualite') ??
  sorted[0];

// ── Hero sidebar : les 4 publications les plus récentes hors une ──────────
const heroList = sorted.filter(a => a.slug !== featuredArticle?.slug).slice(0, 4);

// ── À ne pas manquer : 6 articles suivants ────────────────────────────────
const heroSlugs = new Set([featuredArticle?.slug, ...heroList.map(a => a.slug)]);
const spotlight = sorted.filter(a => !heroSlugs.has(a.slug)).slice(0, 6);

// ── Guides (non-actualité) ─────────────────────────────────────────────────
const guides = sorted.filter(a => a.data.category !== 'actualite').slice(0, 4);

// ── Sections par discipline ────────────────────────────────────────────────
const sportSections = [
  { key: 'mma',        label: 'MMA',        items: sorted.filter(a => a.data.sport === 'mma').slice(0, 3) },
  { key: 'boxe',       label: 'Boxe',       items: sorted.filter(a => a.data.sport === 'boxe').slice(0, 3) },
  { key: 'muay-thai',  label: 'Muay Thaï',  items: sorted.filter(a => a.data.sport === 'muay-thai').slice(0, 3) },
  { key: 'grappling',  label: 'Grappling',  items: sorted.filter(a => a.data.sport === 'grappling').slice(0, 3) },
].filter(s => s.items.length > 0);

// ── Données d'affichage ────────────────────────────────────────────────────
const gradients: Record<string, string> = {
  mma:         'linear-gradient(135deg, #0F1722 0%, #1E4F7A 100%)',
  boxe:        'linear-gradient(135deg, #4a1212 0%, #B91C1C 100%)',
  kickboxing:  'linear-gradient(135deg, #06382b 0%, #0E9F6E 100%)',
  'muay-thai': 'linear-gradient(135deg, #56260b 0%, #D97706 100%)',
  grappling:   'linear-gradient(135deg, #16284f 0%, #2563EB 100%)',
  karate:      'linear-gradient(135deg, #16161d 0%, #4B5563 100%)',
  equipement:  'linear-gradient(135deg, #0F1722 0%, #E63A23 100%)',
  sanda:       'linear-gradient(135deg, #581f0c 0%, #ea580c 100%)',
  lethwei:     'linear-gradient(135deg, #1c1917 0%, #78716c 100%)',
  savate:      'linear-gradient(135deg, #16284f 0%, #2563EB 100%)',
  sambo:       'linear-gradient(135deg, #161616 0%, #b91c1c 100%)',
  k1:          'linear-gradient(135deg, #16162a 0%, #6D28D9 100%)',
};
const catLabel: Record<string, string> = {
  'guide-debutant':       'Guide Débutant',
  'conseil-entrainement': 'Conseil',
  'guide-equipement':     'Équipement',
  'analyse':              'Analyse',
  'actualite':            'Actualité',
  'guide':                'Guide',
};
const sportLabel: Record<string, string> = {
  mma: 'MMA', boxe: 'Boxe', kickboxing: 'Kickboxing', 'muay-thai': 'Muay-Thaï',
  grappling: 'Grappling', karate: 'Karaté', sanda: 'Sanda', lethwei: 'Lethwei',
  savate: 'Savate', sambo: 'Sambo', k1: 'K-1',
};

const disciplineCards = [
  { key: 'mma',        name: 'MMA',           origin: 'Mixed Martial Arts · Mondial' },
  { key: 'boxe',       name: 'Boxe anglaise', origin: 'Boxing · Grande-Bretagne' },
  { key: 'kickboxing', name: 'Kickboxing',    origin: 'Full contact · USA / Japon' },
  { key: 'muay-thai',  name: 'Muay-Thaï',     origin: 'Art martial · Thaïlande' },
  { key: 'grappling',  name: 'Grappling',     origin: 'BJJ · Judo · Wrestling · Sambo' },
  { key: 'guides',     name: 'Guides',        origin: 'Débutant · Intermédiaire · Avancé' },
];

const sportImages: Record<string, string> = {
  mma:          '/images/banners/mma.png',
  boxe:         '/images/banners/boxe.png',
  kickboxing:   '/images/banners/kickboxing.png',
  lethwei:      '/images/banners/lethwei.png',
  sambo:        '/images/banners/sambo.png',
  sanda:        '/images/banners/sanda.png',
  savate:       '/images/banners/savate.png',
  k1:           '/images/banners/kickboxing.png',
  'muay-thai':  '/images/banners/muay-thai.png',
  grappling:    '/images/banners/grappling.png',
  karate:       '/images/banners/karate.png',
  guides:       '/images/banners/guide.png',
};

// Helper : background card propre (évite url('') qui écrase le gradient)
function cardBg(sportKey: string): string {
  const g = gradients[sportKey] || gradients.mma;
  const img = sportImages[sportKey as keyof typeof sportImages];
  return img
    ? `background-image:url('${img}'),${g};background-size:cover,cover;background-position:center top,center;`
    : `background-image:${g};`;
}

// ── SEO : description dynamique basée sur la une ──────────────────────────
const seoDesc = featuredArticle
  ? `FightFocus — ${featuredArticle.data.excerpt ?? featuredArticle.data.title}`
  : 'FightFocus — Le média français des sports de combat : MMA, Boxe, Muay Thai, Kickboxing, Grappling.';
---
<Base title="FightFocus - MMA, Boxe, Muay Thai : Actu, Guides et Analyses" description={seoDesc}>
<div id="app">

  <!-- HERO : À LA UNE + LES DERNIÈRES -->
  {featuredArticle && (
  <section class="home-hero" aria-label="À la une">
    <a href={`/articles/${featuredArticle.slug}`} class="hero-feature">
      <div class="hero-feature__media" style={cardBg(featuredArticle.data.sport)}></div>
      <div class="hero-feature__scrim"></div>
      <div class="hero-feature__content">
        <div class="hero-feature__badges">
          <span class="badge-une"><span>À la une</span></span>
          <span class="badge-sport">{sportLabel[featuredArticle.data.sport] ?? featuredArticle.data.sport}</span>
        </div>
        <h1 class="hero-feature__title" set:html={featuredArticle.data.title}></h1>
        <p class="hero-feature__excerpt">{featuredArticle.data.excerpt}</p>
        <div class="hero-feature__meta">
          <span>{catLabel[featuredArticle.data.category] ?? featuredArticle.data.category}</span>
          <span>{featuredArticle.data.date}</span>
          <span class="read-more">Lire l'article →</span>
        </div>
      </div>
    </a>

    {heroList.length > 0 && (
    <aside class="hero-latest" aria-label="Dernières publications">
      <div class="hero-latest__head">Les dernières</div>
      {heroList.map((a, i) => (
        <a href={`/articles/${a.slug}`} class="latest-item">
          <span class="latest-num">{String(i + 1).padStart(2, '0')}</span>
          <span>
            <span class="latest-cat">{sportLabel[a.data.sport] ?? a.data.sport} · {catLabel[a.data.category] ?? a.data.category}</span>
            <span class="latest-title" set:html={a.data.title}></span>
          </span>
        </a>
      ))}
    </aside>
    )}
  </section>
  )}

  <!-- DISCIPLINES -->
  <section aria-label="Disciplines">
    <div class="sec-bar">
      <h2>Disciplines</h2>
      <div class="sec-line"></div>
    </div>
    <div class="sports-hub">
      {disciplineCards.map(d => (
        <a href={d.key === 'guides' ? '/guides' : `/discipline/${d.key}`} class="sport-hub-card">
          {sportImages[d.key as keyof typeof sportImages] && (
            <div class="sport-hub-img" style={`background-image:url('${sportImages[d.key as keyof typeof sportImages]}');`}></div>
          )}
          <div class="sport-hub-top">
            <div>
              <div class="sport-name">{d.name}</div>
              <div class="sport-origin">{d.origin}</div>
            </div>
          </div>
          <div class="sport-links">
            <div class="sport-link"><span>Articles</span></div>
            <div class="sport-link"><span>Explorer →</span></div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- À NE PAS MANQUER + SIDEBAR -->
  {spotlight.length > 0 && (
  <div class="main-layout">
    <main>
      <div class="sec-bar">
        <h2>À ne pas manquer</h2>
        <div class="sec-line"></div>
        <a href="/guides" class="see-all">Voir tout →</a>
      </div>
      <div class="art-grid">
        {spotlight.map(a => (
          <a href={`/articles/${a.slug}`} class="art-card">
            <div class="art-image" style={cardBg(a.data.sport)}>
              <span class="art-cat-tag">{catLabel[a.data.category] ?? a.data.category}</span>
            </div>
            <div class="art-body">
              <h3 class="art-title-sm" set:html={a.data.title}></h3>
              <p class="art-excerpt">{a.data.excerpt}</p>
              <div class="art-foot">
                <span>{a.data.date}</span>
                <span class="atype t-guide">{sportLabel[a.data.sport] ?? a.data.sport}</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </main>

    <aside class="sidebar-col">
      <div class="nl-widget">
        <div class="widget-head">Newsletter hebdo</div>
        <p>Les meilleurs articles de la semaine, directement dans ta boîte mail. Gratuit.</p>
        <input class="nl-input" type="email" id="nl-email-home" placeholder="votre@email.com" aria-label="Votre adresse email" />
        <button class="nl-btn" onclick="subscribeHome()">S'abonner</button>
        <div id="nl-feedback-home" style="font-size:0.8rem;margin-top:8px;min-height:1.2em;"></div>
      </div>
      <div class="widget">
        <div class="widget-head">Bien débuter</div>
        <div class="widget-body">
          <div class="ev-item"><div class="ev-date">Guide</div><a href="/guides">Guides débutants par discipline</a></div>
          <div class="ev-item"><div class="ev-date">Équip.</div><a href="/equipement">Bien choisir son équipement</a></div>
          <div class="ev-item"><div class="ev-date">Agenda</div><a href="/evenements">Les prochains événements</a></div>
        </div>
      </div>
      <div class="ad-slot ad-rect"></div>
    </aside>
  </div>
  )}

  <!-- GUIDES & ANALYSES -->
  {guides.length > 0 && (
  <section aria-label="Guides et analyses" style="margin-top:3rem;">
    <div class="sec-bar">
      <h2>Guides & Analyses</h2>
      <div class="sec-line"></div>
      <a href="/guides" class="see-all">Tous les guides →</a>
    </div>
    <div class="art-grid">
      {guides.map(a => (
        <a href={`/articles/${a.slug}`} class="art-card">
          <div class="art-image" style={cardBg(a.data.sport)}>
            <span class="art-cat-tag">{catLabel[a.data.category] ?? a.data.category}</span>
          </div>
          <div class="art-body">
            <h3 class="art-title-sm" set:html={a.data.title}></h3>
            <p class="art-excerpt">{a.data.excerpt}</p>
            <div class="art-foot">
              <span>{a.data.date}</span>
              <span class="atype t-guide">{sportLabel[a.data.sport] ?? a.data.sport}</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
  )}

  <!-- RUBRIQUES PAR DISCIPLINE -->
  {sportSections.map(section => (
    <section aria-label={section.label} style="margin-top:3rem;">
      <div class="sec-bar">
        <h2>{section.label}</h2>
        <div class="sec-line"></div>
        <a href={`/discipline/${section.key}`} class="see-all">Tous les articles {section.label} →</a>
      </div>
      <div class="art-grid">
        {section.items.map(a => (
          <a href={`/articles/${a.slug}`} class="art-card">
            <div class="art-image" style={cardBg(section.key)}>
              <span class="art-cat-tag">{catLabel[a.data.category] ?? a.data.category}</span>
            </div>
            <div class="art-body">
              <h3 class="art-title-sm" set:html={a.data.title}></h3>
              <p class="art-excerpt">{a.data.excerpt}</p>
              <div class="art-foot"><span>{a.data.date}</span></div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

</div>

<script>
// ── Newsletter Brevo (page d'accueil) ──────────────────
async function subscribeHome() {
  const emailEl = document.getElementById('nl-email-home') as HTMLInputElement;
  const fb = document.getElementById('nl-feedback-home');
  const email = emailEl?.value?.trim();

  if (!email || !email.includes('@')) {
    if (fb) { fb.textContent = 'Email invalide'; fb.style.color = '#FF6A4D'; }
    return;
  }

  if (fb) { fb.textContent = 'Inscription en cours…'; fb.style.color = '#94a3b8'; }

  try {
    const res = await fetch('https://api.brevo.com/v3/contacts', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
        'api-key': 'BREVO_API_KEY_PLACEHOLDER' // ← Remplacez par votre clé API Brevo (gratuit sur brevo.com)
      },
      body: JSON.stringify({
        email: email,
        listIds: [2], // ID de la liste Brevo — à ajuster dans votre compte
        updateEnabled: true,
        attributes: { SOURCE: 'FightFocus Accueil' }
      })
    });

    if (res.ok || res.status === 204) {
      if (fb) { fb.textContent = '✓ Inscrit ! À bientôt dans ta boîte mail.'; fb.style.color = '#5BD68A'; }
      if (emailEl) emailEl.value = '';
    } else if (res.status === 400) {
      // Le contact existe peut-être déjà
      if (fb) { fb.textContent = '✓ Déjà inscrit — on se retrouve prochainement !'; fb.style.color = '#5BD68A'; }
    } else {
      throw new Error('API error ' + res.status);
    }
  } catch (err) {
    if (fb) { fb.textContent = 'Erreur — réessaie dans quelques instants.'; fb.style.color = '#FF6A4D'; }
  }
}

(window as any).subscribeHome = subscribeHome;
</script>
</Base>
