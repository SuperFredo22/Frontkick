---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
}
const {
  title = "FightFocus - MMA, Boxe, Muay Thai : Actu, Guides et Analyses",
  description = "FightFocus, le média des sports de combat : actualités MMA, analyses, guides boxe, muay-thai, kickboxing et arts martiaux.",
  ogImage = "/og-default.png",
  ogType = "website"
} = Astro.props;

const currentPath = Astro.url.pathname;
const siteUrl = Astro.site ?? 'https://fightfocus.fr';
const canonicalURL = new URL(currentPath, siteUrl);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="google-site-verification" content="s_3JA_wJFz2bQ93Se9Y7qfwhreJA5ZD1F6R04EeJeBc" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Frédéric Laviemienandy" />
  <meta name="theme-color" content="#0B0D12" />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/images/fightfocus-logo.png" />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={new URL(ogImage, siteUrl)} />
  <meta property="og:site_name" content="FightFocus" />
  <meta property="og:locale" content="fr_FR" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@fightfocus_fr" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />
  <!-- Polices auto-hébergées (déclarées dans global.css) : préchargement des critiques -->
  <link rel="preload" href="/fonts/barlow-condensed-700-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-variable-latin.woff2" as="font" type="font/woff2" crossorigin />
  <!-- ?v=2 : cache-busting (les /styles/* sont servis en cache immutable 1 an, cf. vercel.json) -->
  <link rel="stylesheet" href="/styles/global.css?v=2" />

  <slot name="head" />
  <!-- JSON-LD : WebSite + SearchAction -->
  <script type="application/ld+json" is:inline>{
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "FightFocus",
    "url": "https://fightfocus.fr",
    "description": "FightFocus est le média dédié aux sports de combat : MMA, boxe, muay thai, analyses, guides et équipement.",
    "inLanguage": "fr-FR",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "https://fightfocus.fr/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    },
    "publisher": {
      "@type": "Organization",
      "name": "FightFocus",
      "url": "https://fightfocus.fr",
      "logo": {
        "@type": "ImageObject",
        "url": "https://fightfocus.fr/images/fightfocus-logo.png"
      }
    }
  }</script>

  <!-- Google Analytics 4 — se charge uniquement après consentement cookies -->
  <!-- Remplacez G-RPWZQZ03Q2 par votre vrai ID de mesure GA4 -->
  <script is:inline>
    window.GA_MEASUREMENT_ID = 'G-RPWZQZ03Q2';
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      'analytics_storage': 'denied'
    });
    // Si consentement déjà donné, charger GA immédiatement
    if (typeof window !== 'undefined' && localStorage.getItem('cookieConsent') === 'accepted') {
      gtag('consent', 'update', {'analytics_storage': 'granted'});
      (function(){
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.GA_MEASUREMENT_ID;
        document.head.appendChild(s);
        gtag('js', new Date());
        gtag('config', window.GA_MEASUREMENT_ID, {page_path: window.location.pathname});
      })();
    }
  </script>

  <!-- ═══════════════════════════════════════════════════════
       GOOGLE ADSENSE — Activer après validation du compte
       1. Aller sur : https://adsense.google.com
       2. Remplacer ca-pub-XXXXXXXXXX par votre vrai Publisher ID
       3. Décommenter la ligne ci-dessous
       ═══════════════════════════════════════════════════════ -->
  <!-- <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXXXX" crossorigin="anonymous"></script> -->
</head>
<body>

<!-- Thème : sombre par défaut, clair si choisi (appliqué tôt pour éviter le flash) -->
<script is:inline>
  if (localStorage.getItem('theme') === 'light') document.body.classList.add('light-mode');
</script>

<a class="skip-link" href="#app">Aller au contenu</a>

<!-- HEADER -->
<header id="site-header">
  <div class="header-top">
    <a href="/" class="logo" aria-label="FightFocus — Retour à l'accueil">
      <span class="logo-badge" aria-hidden="true">FF</span>
      <span class="logo-wordmark">Fight<span class="logo-accent">Focus</span></span>
    </a>
    <div class="header-actions">
      <form id="searchForm" action="/search" method="get" role="search">
        <input type="text" id="searchInput" name="q" placeholder="Rechercher…" aria-label="Rechercher un article" />
        <button type="submit" id="searchBtn" aria-label="Lancer la recherche">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        </button>
      </form>
      <button id="darkModeToggle" aria-label="Basculer entre thème sombre et clair">
        <svg id="dm-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg id="dm-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
      <button id="hamburger" class="nav-hamburger" aria-label="Menu" aria-expanded="false">
        <svg id="ham-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="close-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" style="display:none;"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>
  <nav class="nav-bar" role="navigation" aria-label="Navigation principale">
    <div class="nav-inner">
      <a href="/" class={`nav-link ${currentPath === '/' ? 'active' : ''}`}>Accueil</a>

      <!-- Disciplines principales -->
      <a href="/discipline/mma"        class={`nav-link ${currentPath.includes('/mma') ? 'active' : ''}`}>MMA</a>
      <a href="/discipline/boxe"       class={`nav-link ${currentPath.includes('/boxe') ? 'active' : ''}`}>Boxe</a>
      <a href="/discipline/kickboxing" class={`nav-link ${currentPath.includes('/kickboxing') || currentPath.includes('/k1') ? 'active' : ''}`}>Kickboxing</a>
      <a href="/discipline/muay-thai"  class={`nav-link ${currentPath.includes('/muay-thai') ? 'active' : ''}`}>Muay Thaï</a>
      <a href="/discipline/grappling"  class={`nav-link ${currentPath.includes('/grappling') ? 'active' : ''}`}>Grappling</a>

      <a href="/autres-disciplines" class={`nav-link ${currentPath.startsWith('/autres-disciplines') || ['/discipline/sanda','/discipline/lethwei','/discipline/savate','/discipline/sambo','/discipline/karate'].some(s => currentPath.startsWith(s)) ? 'active' : ''}`}>Autres</a>

      <a href="/guides"      class={`nav-link ${currentPath.startsWith('/guides') ? 'active' : ''}`}>Guides</a>
      <a href="/equipement"  class={`nav-link ${currentPath.startsWith('/equipement') ? 'active' : ''}`}>Équipement</a>
      <a href="/evenements"  class={`nav-link ${currentPath.startsWith('/evenements') ? 'active' : ''}`}>Événements</a>
      <a href="/classements" class={`nav-link ${currentPath.startsWith('/classements') ? 'active' : ''}`}>Classements</a>
    </div>
  </nav>
</header>

<slot />

<!-- Footer ad placeholder (activé après validation AdSense) -->
<div class="footer-ad">
  <div class="ad-slot ad-leader"></div>
</div>

<!-- CTA NEWSLETTER -->
<section class="footer-cta" aria-label="Newsletter FightFocus">
  <div class="footer-cta-inner">
    <div>
      <div class="footer-cta-kicker">Newsletter</div>
      <h2 class="footer-cta-title">Le meilleur du combat,<br/>chaque semaine.</h2>
      <p>Analyses, guides techniques et conseils d'entraînement, sélectionnés par la rédaction. Gratuit, zéro spam, désinscription en un clic.</p>
    </div>
    <form class="footer-cta-form" id="footerNlForm">
      <div class="footer-cta-row">
        <input type="email" id="nl-email-footer" placeholder="votre@email.com" aria-label="Votre adresse email" required />
        <button type="submit">S'abonner</button>
      </div>
      <div id="nl-feedback-footer" class="footer-cta-feedback" role="status"></div>
    </form>
  </div>
</section>

<!-- FOOTER -->
<footer role="contentinfo">
  <!-- Réassurance -->
  <div class="footer-trust">
    <div class="trust-item">
      <span class="trust-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4.5L6 21l1.5-7.5L2 9h7z"/></svg>
      </span>
      <div>
        <strong>100 % sports de combat</strong>
        <span>MMA, boxe, muay thaï, grappling et plus</span>
      </div>
    </div>
    <div class="trust-item">
      <span class="trust-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
      </span>
      <div>
        <strong>Guides pensés pratiquants</strong>
        <span>Technique, entraînement et équipement</span>
      </div>
    </div>
    <div class="trust-item">
      <span class="trust-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      </span>
      <div>
        <strong>Indépendant & gratuit</strong>
        <span>Un média édité par des passionnés</span>
      </div>
    </div>
  </div>

  <div class="footer-inner">
    <div class="footer-brand">
      <div class="footer-logo">Fight<span class="logo-accent">Focus</span></div>
      <p>Le média des sports de combat. Analyses, guides et équipement pour pratiquants et passionnés.</p>
    </div>
    <div class="footer-col">
      <h4>Disciplines</h4>
      <ul>
        <li><a href="/discipline/mma">MMA / UFC</a></li>
        <li><a href="/discipline/boxe">Boxe anglaise</a></li>
        <li><a href="/discipline/muay-thai">Muay-Thaï</a></li>
        <li><a href="/discipline/grappling">Grappling</a></li>
        <li><a href="/discipline/kickboxing">Kickboxing / K-1</a></li>
        <li><a href="/autres-disciplines">Karaté & Autres</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Ressources</h4>
      <ul>
        <li><a href="/guides">Guides débutants</a></li>
        <li><a href="/equipement">Équipement</a></li>
        <li><a href="/evenements">Événements à venir</a></li>
        <li><a href="/classements">Classements UFC</a></li>
      </ul>
    </div>
    <div class="footer-col">
      <h4>Le site</h4>
      <ul>
        <li><a href="/a-propos">À propos</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
        <li><a href="/politique-confidentialite">Confidentialité</a></li>
      </ul>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© 2026 FightFocus · Tous droits réservés · Frédéric Laviemienandy</span>
    <span>* Liens affiliés — commission perçue sans surcoût pour vous.</span>
    <button class="cookie-manage-link" onclick="showCookieBanner()">Gérer mes cookies</button>
  </div>
</footer>

<!-- BANDEAU COOKIES RGPD -->
<div id="cookie-banner" style="display:none;" role="dialog" aria-label="Gestion des cookies">
  <p>
    Ce site utilise des cookies pour mesurer l'audience et afficher des publicités personnalisées (Google AdSense).
    En cliquant sur "Accepter", vous consentez à leur utilisation.
    <a href="/politique-confidentialite">En savoir plus</a>
  </p>
  <div class="cookie-actions">
    <button class="cookie-btn-refuse" onclick="refuseCookies()">Refuser</button>
    <button class="cookie-btn-accept" onclick="acceptCookies()">Accepter</button>
  </div>
</div>

<script>
  // ── Hamburger menu ──
  const hamburger = document.getElementById('hamburger');
  const navBar = document.querySelector('.nav-bar') as HTMLElement;
  const hamIcon = document.getElementById('ham-icon');
  const closeIcon = document.getElementById('close-icon');

  function closeNav() {
    if (!navBar) return;
    navBar.classList.remove('open');
    if (hamburger) hamburger.setAttribute('aria-expanded', 'false');
    if (hamIcon) (hamIcon as HTMLElement).style.display = 'block';
    if (closeIcon) (closeIcon as HTMLElement).style.display = 'none';
  }

  if (hamburger && navBar) {
    hamburger.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = navBar.classList.toggle('open');
      hamburger.setAttribute('aria-expanded', String(isOpen));
      if (hamIcon) (hamIcon as HTMLElement).style.display = isOpen ? 'none' : 'block';
      if (closeIcon) (closeIcon as HTMLElement).style.display = isOpen ? 'block' : 'none';
    });

    // Ferme le menu quand on clique sur un lien
    navBar.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => closeNav());
    });

    // Ferme le menu quand on tape en dehors
    document.addEventListener('click', (e) => {
      const header = document.querySelector('header') as HTMLElement;
      if (header && !header.contains(e.target as Node)) {
        closeNav();
      }
    });
  }

  // ── Ombre du header au scroll ──
  const siteHeader = document.getElementById('site-header');
  if (siteHeader) {
    const onScroll = () => siteHeader.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // ── Thème : sombre par défaut, bascule vers clair ──
  const toggle = document.getElementById('darkModeToggle');
  const dmMoon = document.getElementById('dm-moon');
  const dmSun = document.getElementById('dm-sun');
  function setThemeIcon(isLight: boolean) {
    // En sombre on propose le soleil (passer en clair), en clair la lune
    if (dmSun) (dmSun as HTMLElement).style.display = isLight ? 'none' : 'block';
    if (dmMoon) (dmMoon as HTMLElement).style.display = isLight ? 'block' : 'none';
  }
  setThemeIcon(document.body.classList.contains('light-mode'));
  if (toggle) {
    toggle.addEventListener('click', () => {
      const isLight = document.body.classList.toggle('light-mode');
      setThemeIcon(isLight);
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    });
  }

  // ── Révélation au scroll (désactivée si mouvement réduit) ──
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const revealEls = document.querySelectorAll('.art-card, .sport-hub-card, .hero-feature, .hero-latest, .widget, .nl-widget');
    const io = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('revealed');
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -20px 0px' });
    revealEls.forEach(el => {
      el.classList.add('will-reveal');
      io.observe(el);
    });
  }

  // ── Cookies ──
  function showCookieBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.style.display = 'flex';
  }
  function acceptCookies() {
    localStorage.setItem('cookieConsent', 'accepted');
    hideBanner();
    loadAnalytics();
  }
  function refuseCookies() {
    localStorage.setItem('cookieConsent', 'refused');
    hideBanner();
  }
  function hideBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.style.display = 'none';
  }
  function loadAnalytics() {
    if (!window.GA_MEASUREMENT_ID || window.GA_MEASUREMENT_ID === 'G-RPWZQZ03Q2') return;
    if (window._gaLoaded) return;
    window._gaLoaded = true;
    // Mettre à jour le consentement GA4
    if (typeof gtag === 'function') {
      gtag('consent', 'update', {'analytics_storage': 'granted'});
    }
    // Charger le script GA4
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://www.googletagmanager.com/gtag/js?id=' + window.GA_MEASUREMENT_ID;
    document.head.appendChild(s);
    s.onload = function() {
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', window.GA_MEASUREMENT_ID, {page_path: window.location.pathname});
    };
  }
  window.addEventListener('DOMContentLoaded', () => {
    if (!localStorage.getItem('cookieConsent')) showCookieBanner();
  });
  (window as any).showCookieBanner = showCookieBanner;
  (window as any).acceptCookies = acceptCookies;
  (window as any).refuseCookies = refuseCookies;

  // ── Newsletter footer (Brevo) ──
  const footerForm = document.getElementById('footerNlForm');
  if (footerForm) {
    footerForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailEl = document.getElementById('nl-email-footer') as HTMLInputElement;
      const fb = document.getElementById('nl-feedback-footer');
      const email = emailEl?.value?.trim();

      if (!email || !email.includes('@')) {
        if (fb) { fb.textContent = 'Email invalide'; fb.style.color = '#FF6A4D'; }
        return;
      }
      if (fb) { fb.textContent = 'Inscription en cours…'; fb.style.color = ''; }

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email, source: 'footer' })
        });
        const data = await res.json().catch(() => null);

        if (res.ok && data && data.ok) {
          const msg = data.status === 'exists'
            ? '✓ Déjà inscrit — on se retrouve prochainement !'
            : '✓ Inscrit ! À bientôt dans ta boîte mail.';
          if (fb) { fb.textContent = msg; fb.style.color = '#5BD68A'; }
          if (emailEl) emailEl.value = '';
        } else {
          if (fb) { fb.textContent = (data && data.error) || 'Erreur — réessaie dans quelques instants.'; fb.style.color = '#FF6A4D'; }
        }
      } catch (err) {
        if (fb) { fb.textContent = 'Erreur — réessaie dans quelques instants.'; fb.style.color = '#FF6A4D'; }
      }
    });
  }
</script>
</body>
</html>
